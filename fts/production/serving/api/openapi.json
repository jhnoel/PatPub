{
  "openapi": "3.0.3",
  "info": {
    "title": "PatPub Search API",
    "version": "1.1.0",
    "description": "Search PatPub's published patent corpus. Results are hydrated from the active release and include publication metadata and text snippets. Query syntax supports the indexed fields title, abstract, claims, description, publication_number, publication_uid, patent_number, application_number, doc_kind, applicant, assignee, ipc, and us_class. Read complete canonical publication Markdown by one publication_uid or a list of up to 100 IDs."
  },
  "paths": {
    "/api/search": {
      "post": {
        "operationId": "searchPatents",
        "summary": "Search published patents",
        "description": "Run a full-text query against the active PatPub release. Use fielded query syntax for precise searches, for example `assignee:Acme AND claims:battery`. `max_hits` is capped at 100. `start_offset` can be used to page through results and is limited to 900.",
        "security": [
          {
            "RouterBearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Search for a technical phrase",
                  "value": {
                    "query": "wireless charging",
                    "max_hits": 10
                  }
                },
                "fielded": {
                  "summary": "Search within an assignee and claims",
                  "value": {
                    "query": "assignee:Acme AND claims:battery",
                    "max_hits": 20
                  }
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "The query uses unsupported fields or invalid search syntax.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "Search results from the active release.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "401": {
            "description": "The router requires a bearer token and the request did not provide a valid token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "The request body exceeds the router's size limit."
          },
          "502": {
            "description": "The active release or search upstream could not be used.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/publications/{publication_uid}": {
      "get": {
        "operationId": "getPatent",
        "summary": "Read complete patent text",
        "description": "Read complete canonical Markdown from the active release using the publication_uid returned by search.",
        "security": [
          {
            "RouterBearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "publication_uid",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PublicationUid"
            },
            "example": "US:9999999:B2"
          }
        ],
        "responses": {
          "200": {
            "description": "Complete publication text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicationResponse"
                },
                "example": {
                  "publication_uid": "US:9999999:B2",
                  "publication_number": "US9999999B2",
                  "markdown": "<!-- publication_uid: US:9999999:B2 -->\n# Patent title\n\n## Abstract\nComplete abstract.\n\n## Description\nComplete description.\n\n## Claims\nComplete claims.\n",
                  "active_release_id": "release-example"
                }
              }
            }
          },
          "400": {
            "description": "Invalid publication ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Publication absent from the active release.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Release or source retrieval failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/publications": {
      "post": {
        "operationId": "getPatents",
        "summary": "Read multiple complete patent texts",
        "description": "Read 1 to 100 canonical publication IDs from one active release. Documents follow input order, duplicate IDs are removed, and missing IDs are reported separately. The shared hydration byte budget applies.",
        "security": [
          {
            "RouterBearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicationsRequest"
              },
              "example": {
                "publication_uids": [
                  "US:9999999:B2",
                  "US:10000000:B2"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete documents and missing IDs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicationsResponse"
                },
                "example": {
                  "documents": [
                    {
                      "publication_uid": "US:9999999:B2",
                      "publication_number": "US9999999B2",
                      "markdown": "<!-- publication_uid: US:9999999:B2 -->\n# Patent title\n\n## Abstract\nComplete abstract.\n\n## Description\nComplete description.\n\n## Claims\nComplete claims.\n",
                      "active_release_id": "release-example"
                    }
                  ],
                  "missing_publication_uids": [
                    "US:10000000:B2"
                  ],
                  "active_release_id": "release-example"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or IDs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds size limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Source retrieval, integrity check, or hydration budget failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "RouterBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Set this only when ROUTER_BEARER_TOKEN is configured on the PatPub router."
      }
    },
    "schemas": {
      "SearchRequest": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Quickwit full-text query. Searches title, abstract, claims, and description by default; indexed metadata fields can be queried explicitly.",
            "example": "wireless charging"
          },
          "max_hits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
            "description": "Maximum number of results to return."
          },
          "start_offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 900,
            "default": 0,
            "description": "Zero-based result offset for pagination."
          }
        },
        "additionalProperties": false
      },
      "SearchResponse": {
        "type": "object",
        "required": [
          "hits",
          "num_hits",
          "active_release_id"
        ],
        "properties": {
          "hits": {
            "type": "array",
            "description": "Matching publications with stored metadata, source pointers, scores, and generated text snippets.",
            "items": {
              "type": "object",
              "properties": {
                "snippets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "active_release_id": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "num_hits": {
            "type": "integer",
            "description": "Total number of matching publications."
          },
          "elapsed_time_micros": {
            "type": "integer"
          },
          "active_release_id": {
            "type": "string"
          },
          "active_selector_sha256": {
            "type": "string"
          },
          "active_manifest_sha256": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "PublicationResponse": {
        "type": "object",
        "required": [
          "publication_uid",
          "publication_number",
          "markdown",
          "active_release_id"
        ],
        "properties": {
          "publication_uid": {
            "$ref": "#/components/schemas/PublicationUid"
          },
          "publication_number": {
            "type": "string",
            "nullable": true,
            "description": "Stored publication number, or null if unavailable."
          },
          "markdown": {
            "type": "string",
            "description": "Complete canonical publication Markdown."
          },
          "active_release_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PublicationsResponse": {
        "type": "object",
        "required": [
          "documents",
          "missing_publication_uids",
          "active_release_id"
        ],
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicationResponse"
            },
            "description": "Complete publications in first occurrence input order; duplicate identifiers are removed."
          },
          "missing_publication_uids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicationUid"
            },
            "description": "Requested identifiers absent from the selected active release, in input order."
          },
          "active_release_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PublicationUid": {
        "type": "string",
        "pattern": "^[A-Z]{2}:[A-Z0-9]+:[A-Z][0-9]?$",
        "example": "US:9999999:B2",
        "description": "Canonical publication identifier returned by search."
      },
      "PublicationsRequest": {
        "type": "object",
        "required": [
          "publication_uids"
        ],
        "additionalProperties": false,
        "properties": {
          "publication_uids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/PublicationUid"
            },
            "description": "One to 100 canonical publication IDs; duplicates count toward the limit and are read once."
          }
        }
      }
    }
  }
}
