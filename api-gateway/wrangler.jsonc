{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "patpub-api-gateway",
  "main": "worker.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.jamienoel.com/patpub/mcp",
      "zone_name": "jamienoel.com"
    },
    {
      "pattern": "api.jamienoel.com/patpub/openapi.json",
      "zone_name": "jamienoel.com"
    },
    {
      "pattern": "api.jamienoel.com/patpub/api/search",
      "zone_name": "jamienoel.com"
    },
    {
      "pattern": "api.jamienoel.com/patpub/api/publications*",
      "zone_name": "jamienoel.com"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
